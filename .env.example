# ── Public (browser) — safe to expose; must be NEXT_PUBLIC_ ─────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origin the browser connects the realtime socket to (backend Socket.IO namespace /realtime)
NEXT_PUBLIC_REALTIME_URL=http://localhost:5000
NEXT_PUBLIC_DEFAULT_LOCALE=bn
NEXT_PUBLIC_SUPPORT_PHONE=01XXXXXXXXX
NEXT_PUBLIC_SUPPORT_EMAIL=support@planthaat.example

# ── Server-only (never exposed to the browser) ──────────────────────
# Base URL of the backend API (the Next.js server calls this)
API_INTERNAL_URL=http://localhost:5000
# Shared secret with the backend BFF integration; set the same value as the backend's BFF_SHARED_SECRET
BFF_SHARED_SECRET=
BACKEND_TIMEOUT_MS=15000
GATEWAY_MAX_BODY_MB=12
# Only needed if the optional on-demand revalidation route is used
REVALIDATE_SECRET=
# Extra allowed origins for the gateway CSRF check (comma-separated)
SITE_ORIGINS_EXTRA=
